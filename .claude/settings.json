{
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "statusMessage": "Checking Solidity compiles before editing with `forge build`",
              "command": "file=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\"); if echo \"$file\" | grep -q '\\.sol$'; then forge build --quiet; fi"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "statusMessage": "Auto-formatting Solidity file with `forge fmt`",
              "command": "file=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\"); if echo \"$file\" | grep -q '\\.sol$'; then forge fmt \"$file\"; fi"
            }
          ]
        }
      ]
    },
    "permissions": {
      "allow": [
        "Bash(forge build:*)",
        "Bash(forge fmt:*)",
        "Bash(forge lint:*)",
        "Bash(forge test:*)",
        "Bash(forge coverage:*)",
        "Bash(forge snapshot:*)",
        "Bash(forge script:*)",
        "Bash(make:*)",
        "Bash(cd:*)",
        "Bash(git status:*)",
        "Bash(git diff:*)",
        "Bash(git log:*)",
        "Bash(git add:*)",
        "Bash(git commit:*)",
        "Bash(git push:*)",
        "Bash(git pull:*)",
        "Bash(git fetch:*)",
        "Bash(git checkout:*)",
        "Bash(git branch:*)",
        "Bash(git stash:*)",
        "Bash(git show:*)",
        "Bash(git remote:*)",
        "Bash(gh pr:*)",
        "Bash(gh issue:*)",
        "Bash(gh repo:*)",
        "Bash(gh run:*)",
        "Bash(gh api:*)",
        "Bash(gh auth status:*)"
      ]
    }
  }